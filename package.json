{
  "name": "tracelens",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source evidence-driven incident intelligence and root-cause investigation for distributed systems.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/shared",
    "packages/demo-services",
    "packages/ingestion",
    "packages/correlation",
    "packages/graph",
    "packages/api",
    "packages/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.64.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^20.16.11",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.2"
  }
}
