<?xml version="1.0" encoding="UTF-8"?>
<!--
  TraceLens — Dependency Manifest (pom.xml)
  ==========================================
  This file documents the direct runtime and development dependencies of the
  TraceLens monorepo for open-source supply-chain transparency and academic
  review purposes.

  Project  : TraceLens
  License  : Apache-2.0
  Runtime  : Node.js >= 20 / npm >= 10
  Repo     : https://github.com/2025sl93056-lab/Tracelens

  NOTE: TraceLens is a Node.js / TypeScript project; this pom.xml is a
  declarative dependency manifest following Maven POM conventions for
  interoperability with academic SBOM tooling and supply-chain scanners.
  It is NOT used to build the project (use `npm install` for that).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- ── Project coordinates ─────────────────────────────────────────── -->
  <groupId>io.github.tracelens</groupId>
  <artifactId>tracelens</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>TraceLens</name>
  <description>
    Open-source evidence-driven incident intelligence and root-cause
    investigation tool for distributed systems. Ingests telemetry (logs,
    metrics, traces) and change events, detects incidents automatically,
    builds an incident timeline, and correlates with recent deployments.
  </description>
  <url>https://github.com/2025sl93056-lab/Tracelens</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>2025sl93039</id>
      <name>Aryan Kumar Singh</name>
      <roles>
        <role>Contributor — M1 Ingestion API, Frontend UI Redesign, CI fixes</role>
      </roles>
      <url>https://github.com/2025sl93039</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/2025sl93056-lab/Tracelens.git</connection>
    <developerConnection>scm:git:https://github.com/2025sl93056-lab/Tracelens.git</developerConnection>
    <url>https://github.com/2025sl93056-lab/Tracelens</url>
    <tag>HEAD</tag>
  </scm>

  <!-- ── Module structure (npm workspaces) ───────────────────────────── -->
  <modules>
    <module>packages/shared</module>
    <module>packages/demo-services</module>
    <module>packages/ingestion</module>
    <module>packages/correlation</module>
    <module>packages/graph</module>
    <module>packages/api</module>
    <module>packages/frontend</module>
  </modules>

  <!-- ── Properties ──────────────────────────────────────────────────── -->
  <properties>
    <node.version>20</node.version>
    <npm.version>10</npm.version>
    <typescript.version>5.6.2</typescript.version>
    <vitest.version>2.1.2</vitest.version>

    <!-- Runtime dependency versions -->
    <express.version>4.21.0</express.version>
    <pg.version>8.13.0</pg.version>
    <jsonwebtoken.version>9.0.2</jsonwebtoken.version>
    <react.version>18.3.1</react.version>
    <react-router-dom.version>6.27.0</react-router-dom.version>
    <xyflow-react.version>12.3.6</xyflow-react.version>
    <vite.version>5.4.8</vite.version>

    <!-- Dev / tooling versions -->
    <prettier.version>3.3.3</prettier.version>
    <eslint.version>9.12.0</eslint.version>
    <tsx.version>4.19.1</tsx.version>
    <supertest.version>7.0.0</supertest.version>
    <vitejs-plugin-react.version>4.3.2</vitejs-plugin-react.version>
  </properties>

  <!-- ═══════════════════════════════════════════════════════════════════
       DIRECT RUNTIME DEPENDENCIES
       (production dependencies present in every deployed package)
       ═══════════════════════════════════════════════════════════════════ -->
  <dependencies>

    <!-- ── packages/ingestion, packages/demo-services, packages/api ── -->
    <dependency>
      <groupId>npm:express</groupId>
      <artifactId>express</artifactId>
      <version>4.21.0</version>
      <scope>runtime</scope>
      <type>npm</type>
      <optional>false</optional>
      <exclusions/>
    </dependency>

    <!-- ── packages/ingestion ── -->
    <dependency>
      <groupId>npm:pg</groupId>
      <artifactId>pg</artifactId>
      <version>8.13.0</version>
      <scope>runtime</scope>
      <type>npm</type>
    </dependency>

    <!-- ── packages/api ── -->
    <dependency>
      <groupId>npm:jsonwebtoken</groupId>
      <artifactId>jsonwebtoken</artifactId>
      <version>9.0.2</version>
      <scope>runtime</scope>
      <type>npm</type>
    </dependency>

    <!-- ── packages/frontend ── -->
