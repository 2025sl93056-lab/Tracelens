# Copy to .env and adjust as needed. NEVER commit a real .env.

# --- PostgreSQL ---
POSTGRES_USER=tracelens
POSTGRES_PASSWORD=tracelens
POSTGRES_DB=tracelens
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Core API (serves the frontend) ---
API_PORT=4000
# Secret used to sign dashboard JWTs. Use a long random value in real deployments.
JWT_SECRET=change-me-in-production
# Allowed CORS origins for browser clients (comma-separated). Defaults to local dev frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Ingestion API ---
INGESTION_PORT=4001
# API key that demo services / collectors use to push telemetry.
INGESTION_API_KEY=dev-ingest-key
# Maximum number of events accepted in a single POST /telemetry/batch request.
INGESTION_MAX_BATCH_SIZE=1000

# --- Shared HTTP hardening ---
# Maximum request body size accepted by both API and ingestion services.
MAX_BODY_SIZE=256kb

# --- Frontend ---
FRONTEND_PORT=5173
# Public build-time URL. /api uses the dashboard's same-origin proxy.
VITE_API_BASE_URL=/api

# --- Observability (Prometheus + Grafana) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# Change this in any shared/production deployment.
GF_SECURITY_ADMIN_PASSWORD=admin
